<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/bg_base">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingTop="32dp"
        android:paddingBottom="12dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:background="@color/bg_surface">

        <TextView
            android:id="@+id/btnBack"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="◀"
            android:textColor="@color/text_muted"
            android:fontFamily="@font/bebas_neue"
            android:textSize="20sp"
            android:layout_marginEnd="12dp"/>

        <TextView
            android:id="@+id/tvCategory"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="영화"
            android:textColor="@color/accent_gold"
            android:fontFamily="@font/bebas_neue"
            android:textSize="22sp"
            android:letterSpacing="0.1"/>

    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/border_default"/>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="장르"
                android:textColor="@color/text_muted"
                android:fontFamily="@font/bebas_neue"
                android:textSize="16sp"
                android:letterSpacing="0.1"
                android:layout_marginBottom="8dp"/>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="220dp"
                android:orientation="vertical"
                android:background="@drawable/btn_category_normal"
                android:layout_marginBottom="24dp">

                <TextView
                    android:id="@+id/tvGenreTop"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:textColor="@color/text_dark"
                    android:fontFamily="@font/galmuri11_bold"
                    android:textSize="18sp"/>

                <TextView
                    android:id="@+id/tvGenreSelected"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="2"
                    android:gravity="center"
                    android:textColor="@color/accent_gold"
                    android:fontFamily="@font/galmuri11_bold"
                    android:textSize="36sp"
                    android:background="@color/accent_gold_dark"/>

                <TextView
                    android:id="@+id/tvGenreBottom"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:textColor="@color/text_dark"
                    android:fontFamily="@font/galmuri11_bold"
                    android:textSize="18sp"/>

            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="와일드카드"
                android:textColor="@color/text_muted"
                android:fontFamily="@font/bebas_neue"
                android:textSize="16sp"
                android:letterSpacing="0.1"
                android:layout_marginBottom="8dp"/>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="220dp"
                android:orientation="vertical"
                android:background="@drawable/btn_category_normal"
                android:layout_marginBottom="24dp">

                <TextView
                    android:id="@+id/tvWildTop"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:textColor="@color/text_dark"
                    android:fontFamily="@font/galmuri11_bold"
                    android:textSize="18sp"/>

                <TextView
                    android:id="@+id/tvWildSelected"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="2"
                    android:gravity="center"
                    android:textColor="@color/accent_gold"
                    android:fontFamily="@font/galmuri11_bold"
                    android:textSize="36sp"
                    android:background="@color/accent_gold_dark"/>

                <TextView
                    android:id="@+id/tvWildBottom"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:textColor="@color/text_dark"
                    android:fontFamily="@font/galmuri11_bold"
                    android:textSize="18sp"/>

            </LinearLayout>

            <TextView
                android:id="@+id/btnSpin"
                android:layout_width="match_parent"
                android:layout_height="64dp"
                android:text="▶ 룰렛 돌리기"
                android:textColor="@color/accent_gold"
                android:fontFamily="@font/bebas_neue"
                android:textSize="22sp"
                android:gravity="center"
                android:letterSpacing="0.1"
                android:background="@drawable/btn_category_active"
                android:layout_marginBottom="12dp"/>

            <TextView
                android:id="@+id/btnMission"
                android:layout_width="match_parent"
                android:layout_height="64dp"
                android:text="▶ 미션 받기"
                android:textColor="@color/text_dark"
                android:fontFamily="@font/bebas_neue"
                android:textSize="22sp"
                android:gravity="center"
                android:letterSpacing="0.1"
                android:background="@drawable/btn_category_normal"/>

        </LinearLayout>

    </ScrollView>

</LinearLayout>